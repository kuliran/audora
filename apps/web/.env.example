VITE_LOCAL_AUTH=false
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_FRONTEND_API_URL=

CLERK_SECRET_KEY=

# Server-only, development-only Codex bridge settings. Keep the token out of
# any VITE_ variable; it must be the same value configured in local Convex.
AUDORA_CODEX_BRIDGE_TOKEN=
# Optional absolute path when `codex` is not discoverable on PATH.
AUDORA_CODEX_BIN=
# The one-command local launcher pins these defaults automatically.
AUDORA_CODEX_MODEL=gpt-5.5
AUDORA_CODEX_REASONING_EFFORT=medium
