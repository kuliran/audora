# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

CONVEX_URL=

# `openai` preserves the hosted behavior. `codex` is accepted only when the
# Convex runtime reports the exact local URL http://127.0.0.1:3210.
AUDORA_AI_PROVIDER=openai
AUDORA_CODEX_BRIDGE_URL=http://127.0.0.1:5173/api/local-codex
# Must match apps/web and contain at least 32 bytes.
AUDORA_CODEX_BRIDGE_TOKEN=

# Hosted Clerk only; leave unset for the local-only setup.
VITE_CLERK_FRONTEND_API_URL=

OPENAI_API_KEY=
ZEP_API_KEY=
ZEP_GRAPH_ID=
SPEECHMATICS_API_KEY=

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WORKFLOW_ID=

FRONTEND_URL=http://127.0.0.1:5173

# notion keys
NOTION_API_KEY=
NOTION_WAITLIST_DATASOURCE_ID=
